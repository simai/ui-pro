{
  "schema_version": 2,
  "id": "smart.thread-list",
  "version": "1.2.2",
  "title": "Thread list",
  "summary": "A person's conversations, newest first: grouped by day, the open one marked, renamed in place, archived or acted on through the Framework's menu, with one Tab stop and the next page asked for at the end.",
  "kind": "composite",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "conversation",
    "threads",
    "chat",
    "navigation"
  ],
  "capabilities": [
    "conversations",
    "rename-in-place",
    "pagination",
    "responsive"
  ],
  "custom_element": "sf-thread-list",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "smart.avatar",
      "smart.badge",
      "smart.context-menu",
      "smart.icon"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "template": {
        "type": "string",
        "const": "default",
        "default": "default"
      },
      "selected": {
        "type": "string",
        "default": "",
        "description": "The id of the open conversation."
      },
      "has-more": {
        "type": "boolean",
        "default": false,
        "description": "A next page exists: reaching the end asks for it."
      },
      "archived": {
        "type": "boolean",
        "default": false,
        "description": "Show the archive: a way back, Restore instead of Archive, no New conversation."
      },
      "no-create": {
        "type": "boolean",
        "default": false,
        "description": "No New conversation."
      },
      "no-manage": {
        "type": "boolean",
        "default": false,
        "description": "No row actions: no menu, no F2."
      },
      "no-archive": {
        "type": "boolean",
        "default": false,
        "description": "No archive: no way to it and no Archive among the row actions."
      },
      "group-by": {
        "enum": [
          "day",
          "none"
        ],
        "default": "day",
        "description": "day: Today, Yesterday, Earlier by updated_at in the reader's time zone. none: one list."
      },
      "label": {
        "type": "string",
        "default": "",
        "description": "The navigation's accessible name; empty is Conversations, or Archive, in the page's language."
      },
      "loading": {
        "type": "boolean",
        "default": false,
        "description": "The shape of the list while the first page loads."
      },
      "status": {
        "type": "string",
        "default": "",
        "description": "A sentence in place of the list (an error); empty clears it."
      }
    }
  },
  "contracts": {
    "thread": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "description": "ISO 8601; orders the list and groups it by day."
        },
        "archived": {
          "type": "boolean"
        },
        "caption": {
          "type": "string",
          "description": "A quiet second line: who it is with, the last message."
        },
        "unread": {
          "type": "integer",
          "minimum": 0
        },
        "avatar": {
          "type": "object",
          "properties": {
            "image_url": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "slots": {
      "type": "object",
      "properties": {
        "footer": {
          "type": "string",
          "description": "Under the list, after the way to the archive (a usage meter, a settings link)."
        }
      }
    },
    "properties": {
      "type": "object",
      "properties": {
        "threads": {
          "type": "array",
          "description": "Read-only: the conversations shown, newest first."
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ]
          },
          "description": "Row actions of the host's own, after Rename and Archive."
        }
      }
    },
    "css_variables": {
      "type": "object",
      "properties": {
        "--sf-thread-list-inset": {
          "type": "string"
        },
        "--sf-thread-list-row-height": {
          "type": "string"
        },
        "--sf-thread-list-radius": {
          "type": "string"
        },
        "--sf-thread-list-hover-background-color": {
          "type": "string"
        },
        "--sf-thread-list-current-background-color": {
          "type": "string"
        }
      }
    }
  },
  "methods": {
    "setThreads": {
      "summary": "Replace the list; only the conversations of the shown view (archived or not) are kept.",
      "arguments": [
        {
          "name": "threads",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "updated_at": {
                  "type": "string",
                  "description": "ISO 8601; orders the list and groups it by day."
                },
                "archived": {
                  "type": "boolean"
                },
                "caption": {
                  "type": "string",
                  "description": "A quiet second line: who it is with, the last message."
                },
                "unread": {
                  "type": "integer",
                  "minimum": 0
                },
                "avatar": {
                  "type": "object",
                  "properties": {
                    "image_url": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  }
                }
              },
              "required": [
                "id",
                "title"
              ]
            }
          }
        },
        {
          "name": "options",
          "required": false,
          "schema": {
            "type": "object",
            "properties": {
              "hasMore": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    },
    "appendThreads": {
      "summary": "The next page, after the ones shown; a conversation already listed is not repeated.",
      "arguments": [
        {
          "name": "threads",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "updated_at": {
                  "type": "string",
                  "description": "ISO 8601; orders the list and groups it by day."
                },
                "archived": {
                  "type": "boolean"
                },
                "caption": {
                  "type": "string",
                  "description": "A quiet second line: who it is with, the last message."
                },
                "unread": {
                  "type": "integer",
                  "minimum": 0
                },
                "avatar": {
                  "type": "object",
                  "properties": {
                    "image_url": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  }
                }
              },
              "required": [
                "id",
                "title"
              ]
            }
          }
        },
        {
          "name": "options",
          "required": false,
          "schema": {
            "type": "object",
            "properties": {
              "hasMore": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    },
    "upsert": {
      "summary": "A new or changed conversation, placed where its date puts it.",
      "arguments": [
        {
          "name": "thread",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "title": {
                "type": "string"
              },
              "updated_at": {
                "type": "string",
                "description": "ISO 8601; orders the list and groups it by day."
              },
              "archived": {
                "type": "boolean"
              },
              "caption": {
                "type": "string",
                "description": "A quiet second line: who it is with, the last message."
              },
              "unread": {
                "type": "integer",
                "minimum": 0
              },
              "avatar": {
                "type": "object",
                "properties": {
                  "image_url": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "id",
              "title"
            ]
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    },
    "removeThread": {
      "summary": "Take one conversation off the list.",
      "arguments": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    },
    "setLoading": {
      "summary": "While the first page loads: the shape of the list, and the list busy. Deprecated: the setting loading (until 2026-12-01).",
      "arguments": [
        {
          "name": "loading",
          "required": true,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    },
    "setStatus": {
      "summary": "A sentence in place of the list (an error); empty clears it. Deprecated: the setting status (until 2026-12-01).",
      "arguments": [
        {
          "name": "message",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    },
    "moreFailed": {
      "summary": "The next page could not be loaded: reaching the end asks again.",
      "arguments": [],
      "returns": {
        "type": "null"
      }
    },
    "rename": {
      "summary": "Start renaming a conversation in place, as F2 does.",
      "arguments": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    },
    "openMenu": {
      "summary": "Open a conversation's actions, as the row's «⋯» and Shift+F10 do.",
      "arguments": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "anchor",
          "required": true,
          "schema": {
            "type": "object"
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    }
  },
  "events": {
    "sf-thread-list-create": {
      "summary": "New conversation was pressed.",
      "payload": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "sf-thread-list-open": {
      "summary": "A conversation is asked for (vocabulary open); the host writes selected back. The 1.0 name sf-thread-list-select follows until 2026-12-01.",
      "payload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "sf-thread-list-rename": {
      "summary": "A conversation was renamed in place; the new title is shown at once. A host that cannot keep it upserts the old title.",
      "payload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    },
    "sf-thread-list-archive": {
      "summary": "Archive {ids, id} (vocabulary archive; id stays for 1.0 listeners).",
      "payload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "sf-thread-list-restore": {
      "summary": "Restore {ids, id} (vocabulary restore). The 1.0 name sf-thread-list-unarchive follows until 2026-12-01.",
      "payload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "sf-thread-list-apply": {
      "summary": "One of the host's row actions: {action, scope: entry, ids, id} (vocabulary apply). The 1.0 name sf-thread-list-action follows until 2026-12-01.",
      "payload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "const": "entry"
          }
        },
        "required": [
          "id",
          "action"
        ]
      }
    },
    "sf-thread-list-load-more": {
      "summary": "The end came into view while has-more: {direction: after}.",
      "payload": {
        "type": "object",
        "properties": {
          "direction": {
            "const": "after"
          }
        },
        "additionalProperties": false
      }
    },
    "sf-thread-list-toggle": {
      "summary": "The archive, or the way back. The 1.0 name sf-thread-list-view follows until 2026-12-01.",
      "payload": {
        "type": "object",
        "properties": {
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "archived"
        ]
      }
    }
  },
  "state": {
    "machines": {
      "list": [
        "loading",
        "ready",
        "empty"
      ],
      "row": [
        "idle",
        "renaming"
      ],
      "more": [
        "idle",
        "loading"
      ]
    },
    "visual_states": [
      "default",
      "loading",
      "empty",
      "selected",
      "disabled"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "host",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-pro",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "fetching conversations",
      "deciding which conversation is open",
      "access decisions"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "titles and captions (drawn as text)",
      "avatar image URLs (passed to sf-avatar)"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "navigation",
    "accessible_name": "internal",
    "keyboard": [
      "Tab",
      "ArrowUp",
      "ArrowDown",
      "Home",
      "End",
      "Enter",
      "Space",
      "F2",
      "Shift+F10",
      "ContextMenu",
      "Escape"
    ],
    "focus": "One Tab stop for the list (roving tabindex: the row last moved to, else the open one, else the first). The open row carries aria-current=page and medium weight, and the system highlight in forced colours. F2 renames in place (Enter keeps, Escape gives up and does not reach a surrounding panel, leaving keeps); focus returns to the row. Shift+F10 or the menu key opens the row's actions; the «⋯» is not a Tab stop."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "en",
      "ru"
    ],
    "responsive": [
      "desktop",
      "mobile",
      "hover-none"
    ],
    "skeleton": {
      "shape": "rows",
      "while_loading": "template"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": []
  },
  "readiness": {
    "level": "host-required",
    "required_checks": [
      "manifest",
      "loader-rule",
      "thread-list-contract",
      "thread-list-browser"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "89834691fb9dce692be5353f3214df7aee3a7e27",
      "ui_smart_revision": "89834691fb9dce692be5353f3214df7aee3a7e27"
    },
    "aliases": [],
    "deprecations": [],
    "replacement": null,
    "migrations": [
      {
        "from": "1.0.0",
        "to": "1.1.0",
        "changes": [
          "standard simai.smart-component 1.3.8: the element is made from component.json; dated aliases in aliases.json",
          "sf-thread-list-select -> sf-thread-list-open until 2026-12-01 (event)",
          "sf-thread-list-unarchive -> sf-thread-list-restore until 2026-12-01 (event)",
          "sf-thread-list-action -> sf-thread-list-apply until 2026-12-01 (event)",
          "sf-thread-list-view -> sf-thread-list-toggle until 2026-12-01 (event)"
        ]
      }
    ]
  },
