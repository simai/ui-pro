  "ai_guidance": {
    "use_when": "Use sf-thread-list for a list of conversations -- an assistant's or people's chats -- the host feeds through setThreads and upsert. Promoted from simai/ui-chat sf-chat-thread-list (owner decision 2026-10-25).",
    "do_not": [
      "Do not fetch from the element; the host answers sf-thread-list-load-more",
      "Do not expect the list to move selected on a click; set it when the conversation is open",
      "Do not put markup in titles or captions; they are text"
    ],
    "required_reads": [
      "inputs",
      "contracts",
      "methods",
      "events",
      "accessibility"
    ],
    "minimal_example": "<sf-thread-list selected=\"t1\"></sf-thread-list>",
    "owner_commands": [
      "node scripts/test.mjs",
      "node scripts/run-browser-probes.mjs <free output> <package output>"
    ]
  }
}
