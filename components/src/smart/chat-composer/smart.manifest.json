  "ai_guidance": {
    "use_when": "Use sf-chat-composer for the question field of a chat window: it reports a send, a stop and the files a person offers; the host sends, uploads, and hands the chips back as files.",
    "do_not": [
      "Do not upload from the element; listen to attach and set files",
      "Do not take the element's type and size check for the server's acceptance",
      "Do not clear it from the submit event; clear it once the host took the message"
    ],
    "required_reads": [
      "inputs",
      "contracts",
      "events",
      "accessibility"
    ],
    "minimal_example": "<sf-chat-composer maxlength=\"4000\" attachments accept=\".pdf,.docx\" max-files=\"5\"></sf-chat-composer>",
    "owner_commands": [
      "node scripts/test.mjs",
      "node scripts/run-manifest-probes.mjs <free output> <package output> chat-composer"
    ]
  }
}
