{
  "schema_version": 2,
  "id": "smart.chat-composer",
  "version": "1.0.2",
  "title": "Chat composer",
  "summary": "Where a question is written and files are added: Enter sends, Shift+Enter breaks the line, an IME composition is never cut short, the send button becomes «stop waiting» while an answer is awaited, and files are only reported for the host to upload; their chips come back as files.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "chat",
    "composer",
    "input",
    "attachments"
  ],
  "capabilities": [
    "input",
    "keyboard",
    "attachments",
    "drag-and-drop",
    "responsive"
  ],
  "custom_element": "sf-chat-composer",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "component.icon-buttons",
      "component.textarea",
      "smart.icon"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates.",
        "const": "default"
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "root-style": {
        "type": "string",
        "default": ""
      },
      "placeholder": {
        "type": "string",
        "description": "Empty uses the composer's own word «Спросите что-нибудь»."
      },
      "maxlength": {
        "type": "integer",
        "default": 4000,
        "description": "bootstrap.limits.message_chars.",
        "minimum": 1
      },
      "max-files": {
        "type": "integer",
        "default": 5,
        "minimum": 1
      },
      "max-bytes": {
        "type": "integer",
        "default": 0,
        "description": "0 checks no size.",
        "minimum": 0
      },
      "accept": {
        "type": "string",
        "default": "",
        "description": "Comma-separated extensions, e.g. .pdf,.docx."
      },
      "attachments": {
        "type": "boolean",
        "default": false,
        "description": "Files may be added."
      },
      "busy": {
        "type": "boolean",
        "default": false,
        "description": "An answer is awaited: send becomes stop."
      },
      "disabled": {
        "type": "boolean",
        "default": false,
        "description": "Writing is off, e.g. no consent."
      },
      "value": {
        "type": "string",
        "default": "",
        "description": "the text in the field (the draft); setting it is as if typed: the field grows to it. The attribute gives the first text; the property reads the field."
      },
      "files": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "The stored file's id; a chip with an id and no error is sent with the message."
            },
            "localId": {
              "type": "string",
              "description": "The host's key while it uploads."
            },
            "name": {
              "type": "string",
              "description": "The file's name, drawn as text."
            },
            "bytes": {
              "type": "number"
            },
            "progress": {
              "type": [
                "number",
                "null"
              ],
              "description": "0..1 while uploading; null or 1 when done."
            },
            "error": {
              "type": [
                "string",
                "null"
              ],
              "description": "The server's refusal, the chip's second line."
            }
          }
        },
        "description": "The chips as the host knows them, a property, the action set-files or the JSON island."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "file": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The stored file's id; a chip with an id and no error is sent with the message."
        },
        "localId": {
          "type": "string",
          "description": "The host's key while it uploads."
        },
        "name": {
          "type": "string",
          "description": "The file's name, drawn as text."
        },
        "bytes": {
          "type": "number"
        },
        "progress": {
          "type": [
            "number",
            "null"
          ],
          "description": "0..1 while uploading; null or 1 when done."
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "The server's refusal, the chip's second line."
        }
      }
    },
    "send": {
      "const": "Enter or the send button dispatches sf-chat-composer-submit {text, attachment-ids} (cancelable) when there is text or a ready chip, nothing uploading, not busy, not disabled and within maxlength. The host sends and calls clear() once it took the message."
    },
    "files": {
      "const": "Files offered by the button, a drop or a paste are checked by accept, max-bytes and max-files; sf-chat-composer-attach {files, rejected} reports them and the notice names each refusal. The host uploads and sets files; a chip's remove dispatches sf-chat-composer-detach {id, name}."
    },
    "css_variables": {
      "type": "object",
      "properties": {
        "--sf-chat-composer-background-color": {
          "type": "string"
        },
        "--sf-chat-composer-border-color": {
          "type": "string"
        },
        "--sf-chat-composer-hint-color": {
          "type": "string"
        },
        "--sf-chat-composer-height": {
          "type": "string"
        }
      }
    }
  },
  "methods": {
    "setFiles": {
      "summary": "The chips, as the files property (the action set-files).",
      "arguments": [
        {
          "name": "files",
          "schema": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The stored file's id; a chip with an id and no error is sent with the message."
                },
                "localId": {
                  "type": "string",
                  "description": "The host's key while it uploads."
                },
                "name": {
                  "type": "string",
                  "description": "The file's name, drawn as text."
                },
                "bytes": {
                  "type": "number"
                },
                "progress": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "0..1 while uploading; null or 1 when done."
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The server's refusal, the chip's second line."
                }
              }
            }
          }
        }
      ],
      "returns": {
        "type": "object",
        "description": "{outcome: applied}"
      }
    },
    "clear": {
      "summary": "Empty the field and the notice (the action clear).",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied}"
      }
    },
    "focus": {
      "summary": "Focus the field (the base's focus, delegated).",
      "arguments": [
        {
          "name": "options",
          "required": false,
          "schema": {
            "type": "object"
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    }
  },
  "events": {
    "sf-chat-composer-submit": {
      "summary": "Send: the trimmed text and the ids of the ready files. Cancelling it keeps the notice. The 0.3 name sf-chat-send {text, attachmentIds} follows it until 2026-12-01.",
      "payload": {
        "type": "object",
        "required": [
          "text",
          "attachmentIds"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "attachmentIds": {
            "type": "array"
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-chat-composer-stop": {
      "summary": "«Остановить ожидание» was pressed. The 0.3 name sf-chat-stop follows it until 2026-12-01.",
      "payload": {
        "type": "object",
        "required": [],
        "properties": {},
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-chat-composer-attach": {
      "summary": "Files were offered by the button, a drop or a paste; rejected by type, size or count, each with a reason. The 0.3 name sf-chat-files follows it until 2026-12-01.",
      "payload": {
        "type": "object",
        "required": [
          "files",
          "rejected"
        ],
        "properties": {
          "files": {
            "type": "array"
          },
          "rejected": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file",
                "reason"
              ],
              "properties": {
                "file": {
                  "type": "object"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-chat-composer-detach": {
      "summary": "A chip's remove was pressed. The 0.3 sf-chat-action {action: remove-attachment, id, name} follows it until 2026-12-01.",
      "payload": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {},
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-chat-send": {
      "summary": "Dated alias of sf-chat-composer-submit until 2026-12-01 (split).",
      "payload": {
        "type": "object"
      },
      "alias_of": "sf-chat-composer-submit"
    },
    "sf-chat-stop": {
      "summary": "Dated alias of sf-chat-composer-stop until 2026-12-01 (same-detail).",
      "payload": {
        "type": "object"
      },
      "alias_of": "sf-chat-composer-stop"
    },
    "sf-chat-files": {
      "summary": "Dated alias of sf-chat-composer-attach until 2026-12-01 (same-detail).",
      "payload": {
        "type": "object"
      },
      "alias_of": "sf-chat-composer-attach"
    },
    "sf-chat-action": {
      "summary": "Dated alias of sf-chat-composer-detach until 2026-12-01 (split).",
      "payload": {
        "type": "object"
      },
      "alias_of": "sf-chat-composer-detach"
    }
  },
  "state": {
    "machines": {
      "send": [
        "idle",
        "busy"
      ],
      "length": [
        "under",
        "near",
        "over"
      ],
      "drop": [
        "idle",
        "dragging"
      ]
    },
    "visual_states": [
      "default",
      "disabled",
      "error",
      "active"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "host",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-pro",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "fetching or polling the chat API",
      "access decisions",
      "deciding whether a file is accepted by the server",
      "uploading files"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "file names (drawn as text)",
      "pasted and dropped files"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "form",
    "accessible_name": "internal",
    "keyboard": [
      "Enter",
      "Shift+Enter",
      "Tab"
    ],
    "focus": "The field is named and described by the character count shown past 80 % of the limit; a polite line speaks only when a threshold is crossed. A rejected file is a role=alert notice. Enter while an answer is awaited says why nothing was sent. «Stop waiting» returns focus to the field."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "en",
      "ru"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ]
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "host-required",
    "required_checks": [
      "manifest",
      "loader-rule",
      "chat-composer-probe"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "0edd49be08f802b60ed92f176b68911a42a12f3f",
      "ui_smart_revision": "0edd49be08f802b60ed92f176b68911a42a12f3f"
    },
    "aliases": [],
    "deprecations": [],
    "replacement": null,
    "migrations": [
      {
        "from": "0.3.1",
        "to": "1.0.0",
        "changes": [
          "moved from simai/ui-chat to ui-pro (D31): standard simai.smart-component 1.3.9, the element is made from component.json; words in lang/; dated aliases in aliases.json; nothing imported from chat-core or component/chat",
          "sf-chat-send {text, attachmentIds} -> sf-chat-composer-submit {text, attachment-ids} until 2026-12-01 (event, split alias)",
          "sf-chat-stop -> sf-chat-composer-stop until 2026-12-01 (event)",
          "sf-chat-files -> sf-chat-composer-attach until 2026-12-01 (event)",
          "sf-chat-action {action: remove-attachment, id, name} -> sf-chat-composer-detach {id, name} until 2026-12-01 (event, split alias)",
          "setFiles(files) is the action set-files and the setting files; clear() is the action clear"
        ]
      },
      {
        "from": "1.0.0",
        "to": "1.0.1",
        "changes": [
          "The first-paint snapshot's sheets.json lists the utility sheets its markup uses (retaken on ui-source 5ba9399); no behaviour changed. Nothing to change for a host."
        ]
      }
    ]
  },
