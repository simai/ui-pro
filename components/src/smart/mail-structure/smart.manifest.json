  "ai_guidance": {
    "use_when": "Use sf-mail-structure wherever a person sees and rearranges the blocks of a letter in SIMAI Email Editor.",
    "do_not": [
      "Do not change the letter in the element; listen for its events and do it in the host",
      "Do not keep a block before the pinned header or after the pinned footer; the element already reports the nearest place",
      "Do not draw a second «Добавить блок» beside it"
    ],
    "required_reads": [
      "inputs",
      "contracts",
      "events",
      "accessibility"
    ],
    "minimal_example": "<sf-mail-structure id=\"structure\"></sf-mail-structure> <script>structure.rows = [{id: 'b1', title: 'Заголовок', icon: 'title'}];</script>",
    "owner_commands": [
      "node scripts/test.mjs",
      "node scripts/run-manifest-probes.mjs <free output> <package output> mail-structure"
    ]
  }
}
