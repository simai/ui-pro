  "ai_guidance": {
    "use_when": "Use sf-content-editor wherever a person writes the content of a page (a Composition Document of the profile structured-content).",
    "do_not": [
      "Do not store the page in the element; listen for change and save the document it carries",
      "Do not write a parameter equal to its default; the editor already leaves it out",
      "Do not turn an unknown block into a paragraph; the editor keeps it as it is"
    ],
    "required_reads": [
      "inputs",
      "contracts",
      "events",
      "accessibility"
    ],
    "minimal_example": "<sf-content-editor id=\"page\"></sf-content-editor> <script>page.document = doc; page.addEventListener('change', (e) => save(e.detail.document));</script>",
    "owner_commands": [
      "node scripts/test.mjs",
      "node scripts/run-manifest-probes.mjs <free output> <package output> content-editor"
    ]
  }
}
