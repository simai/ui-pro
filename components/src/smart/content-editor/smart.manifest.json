{
  "schema_version": 2,
  "id": "smart.content-editor",
  "version": "1.0.0",
  "title": "Content editor",
  "summary": "The content mode of the SIMAI page editor: a page typed as one flow over a Composition Document (structured-content). Enter and Backspace split and join blocks, Markdown at a line's start and / change a block's kind, the gutter's + and grip add, move and open a block's menu, a selection gets the inline bar, Esc chooses blocks, a paste becomes blocks through html@1, a table goes by Tab. A block's parameters are a form from its editor manifest. The element saves nothing: it sends the new Document in change.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "content",
    "editor",
    "composition",
    "blocks",
    "text"
  ],
  "capabilities": [
    "interaction",
    "keyboard",
    "responsive",
    "editing"
  ],
  "custom_element": "sf-content-editor",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "smart.context-menu",
      "smart.dropdown",
      "smart.icon",
      "smart.icon-button",
      "smart.inline-editor",
      "smart.input",
      "smart.switch"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates."
      },
      "root-class": {
        "type": "string",
        "default": ""
      },
      "root-style": {
        "type": "string",
        "default": ""
      },
      "label": {
        "type": "string",
        "description": "The accessible name of the page's blocks."
      },
      "document": {
        "type": "object",
        "default": null,
        "description": "The page: a Composition Document of the profile structured-content. Setting a new one starts editing it; the one the editor sent in change is recognised and kept."
      },
      "kinds": {
        "type": "array",
        "default": [],
        "description": "The kinds the / menu and the + of the gutter offer, by id (paragraph, heading-2, heading-3, list, ordered-list, quote, alert, details, steps, table, figure, code, divider, tabs, card, grid, html). Empty offers the first thirteen."
      },
      "editor-manifests": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object"
        },
        "description": "Composition editor manifests of a host's own types, or ones that replace the Framework's for a type: the parameters form of a block is built from them."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "document": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "simai.composition.document"
        },
        "profile": {
          "const": "structured-content"
        },
        "root": {
          "type": "object",
          "description": "content.document: data.title, slots.default the blocks."
        }
      },
      "required": [
        "schema",
        "root"
      ]
    },
    "change": {
      "const": "Every change dispatches change {document, reason} with the whole Document; nothing is stored by the element. select {ids} says which blocks are chosen; leave {} is Esc with blocks chosen."
    }
  },
  "methods": {
    "edit": {
      "summary": "Start typing in a block, the first with no id; refused unknown for a block not in the page.",
      "arguments": [
        {
          "name": "id",
          "schema": {}
        }
      ],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason: unknown}"
      }
    },
    "select": {
      "summary": "Choose blocks as Esc and Shift+arrows do; refused unknown, not-siblings.",
      "arguments": [
        {
          "name": "ids",
          "schema": {
            "type": "array"
          }
        }
      ],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason: unknown | not-siblings}"
      }
    },
    "insert": {
      "summary": "Make a block of an offered kind after a block, or at the end of the page; refused unknown.",
      "arguments": [
        {
          "name": "kind",
          "schema": {}
        },
        {
          "name": "after",
          "schema": {}
        }
      ],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason: unknown}"
      }
    },
    "undo": {
      "summary": "One step back, as ⌘Z; refused empty with nothing to undo.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason: empty}"
      }
    },
    "redo": {
      "summary": "One step forward, as ⇧⌘Z; refused empty.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason: empty}"
      }
    }
  },
  "events": {
    "change": {
      "summary": "The page changed: {document, reason}. The host saves the document.",
      "payload": {
        "type": "object",
        "required": [
          "document",
          "reason"
        ],
        "properties": {
          "document": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "sf-content-editor-select": {
      "summary": "These blocks are chosen: {ids}; empty when none is.",
      "payload": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "sf-content-editor-leave": {
      "summary": "Esc with blocks chosen: the person asks to leave the text.",
      "payload": {
        "type": "object",
        "required": [],
        "properties": {},
        "additionalProperties": true
      }
    }
  },
  "state": {
    "machines": {
      "mode": [
        "typing",
        "picked",
        "idle"
      ]
    },
    "visual_states": [
      "default",
      "empty",
      "open",
      "closed",
      "selected",
      "active"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "host",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-pro",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "storing the page",
      "uploading files",
      "rendering the published page"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "the Document's text, drawn as text",
      "pasted HTML, read through the html@1 subset",
      "link addresses, kept only when safe"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "group",
    "accessible_name": "internal",
    "keyboard": [
      "Tab",
      "Enter",
      "Backspace",
      "ArrowUp",
      "ArrowDown",
      "Alt+ArrowUp",
      "Alt+ArrowDown",
      "Escape",
      "Meta+Z"
    ],
    "focus": "One tab stop, on the field last typed in. Esc chooses the block it is in; the arrows choose others, Enter types again. The / list is announced through aria-activedescendant; changes are said in a status line."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "en",
      "ru"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ]
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "host-required",
    "required_checks": [
      "manifest",
      "loader-rule",
      "content-editor-probe"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "339f094bd2f630fcf724ffcd670a864af5aa8f7a",
      "ui_smart_revision": "339f094bd2f630fcf724ffcd670a864af5aa8f7a"
    },
    "aliases": [],
    "deprecations": [],
    "replacement": null,
    "migrations": []
  },
