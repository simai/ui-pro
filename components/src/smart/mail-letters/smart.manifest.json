  "ai_guidance": {
    "use_when": "Use sf-mail-letters wherever a person picks among the letters they have in SIMAI Email Editor.",
    "do_not": [
      "Do not open, copy, rename or delete in the element; listen for its events and do it in the host",
      "Do not pass a worded date in at; pass the moment and let the row word it",
      "Do not confirm a delete inside the element; the host asks",
      "Do not draw a second search field or order control beside it; set query and order instead"
    ],
    "required_reads": [
      "inputs",
      "contracts",
      "events",
      "accessibility"
    ],
    "minimal_example": "<sf-mail-letters id=\"letters\"></sf-mail-letters> <script>letters.letters = [{id: 'prj_1', title: 'Осенняя рассылка', at: '2026-10-29T08:00:00Z', blocks: 7}];</script>",
    "owner_commands": [
      "node scripts/test.mjs",
      "node scripts/run-manifest-probes.mjs <free output> <package output> mail-letters"
    ]
  }
}
