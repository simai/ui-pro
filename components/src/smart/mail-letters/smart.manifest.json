        "sha256": "a0086b57d95fba396142604f6fb304b1f160992e773bd8fe36c6114738e8456b"
      },
      {
        "path": "src/smart/mail-letters/js/templates/default.css",
        "sha256": "9edd09ba51724e6f77316359fddabec9d2ba16252df27ef0f7d8ce41064b5059"
