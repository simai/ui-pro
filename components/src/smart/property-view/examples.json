  "pages": [
    {
      "name": "conformance",
      "title": "sf-property-view against component.json (standard simai.smart-component 1.3.8 §12, gate 20; simai/ui-pro#3, #4)",
      "format": "stands/15-scenarios (A4 modal: a page, probes in steps); the runner is the SIMAI Framework's tests/browser/manifest-probes.browser.mjs through tests/browser/package-manifest-probes.browser.mjs",
      "page": {
        "lang": "ru",
        "body": [
          "<main style=\"width: 1100px\">",
          "  <sf-property-view id=\"p\" record-id=\"r1\" collection=\"workbench.solutions\" sections-as=\"tabs\" aria-label=\"Запись\"></sf-property-view>",
          "  <sf-property-view id=\"missing\" record-id=\"r-999\" aria-label=\"Запись\"></sf-property-view>",
          "  <sf-property-view id=\"panel\" panel record-id=\"r1\" panel-label=\"Запись\"></sf-property-view>",
          "</main>"
        ]
      },
      "checks": [
        {
          "id": "p1-saved",
          "title": "an applied group save is the fact sf-property-view-saved {id, revision}, once",
          "covers": "events.saved (simai/ui-pro#4 item 1), actions.edit-group, actions.save-group, values.revision",
          "steps": [
            {
              "script": "(() => { window.__calls = []; let revision = 1; const record = (id) => ({record_id: id, collection: 'workbench.solutions', revision: String(revision), label: 'Портал клиента', editable: true, actions: ['record.edit'], address: '/admin/r1', sections: [{key: 'main', label: 'Основное', groups: [{key: 'g', label: 'Главное', columns: 1, fields: [{key: 'title', label: 'Название', propertyType: 'string', width: 'full', value: 'Портал клиента'}]}]}, {key: 'links', label: 'Связи', groups: [{key: 'l', label: 'Ссылки', columns: 1, fields: [{key: 'site', label: 'Сайт', propertyType: 'string', width: 'full', value: 'simai.io'}]}]}]}); const port = {id: 'simai.property-view-port', version: '1.14.0', capabilities: [], raise: async (intent, payload) => { window.__calls.push(intent); if (window.__never) return new Promise(() => {}); if (intent === 'record.load') return payload.record_id === 'r1' ? {answer: 'applied', record: record('r1')} : {answer: 'refused', reason: 'record-unknown', message: 'Запись не найдена'}; if (intent === 'group.save') { revision += 1; return {answer: 'applied', revision: String(revision), record: record('r1')}; } return {answer: 'unavailable', reason: 'capability-not-provided'}; } }; document.querySelectorAll('sf-property-view').forEach((one) => one.setHostPort(port)); return true; })()",
              "wait": 900,
              "expect": {
                "values": {
                  "#p.revision": "1",
                  "#p.section": "main"
                }
              }
            },
            {
              "action": {
                "name": "edit-group",
                "with": {
                  "section": "main",
                  "group": "g"
                }
              },
              "target": "#p",
              "wait": 300
            },
            {
              "script": "(() => { const el = document.getElementById('p'); const field = el.sections[0].groups[0].fields[0]; el.changeField(field, 'Портал клиента 2'); return true; })()",
              "wait": 200
            },
            {
              "action": {
                "name": "save-group"
              },
              "target": "#p",
              "wait": 600,
              "expect": {
                "returns": {
                  "outcome": "applied"
                },
                "events": [
                  {
                    "name": "sf-property-view-saved",
                    "count": 1,
                    "detail": {
                      "id": "r1",
                      "revision": "2"
                    }
                  }
                ],
                "values": {
                  "#p.revision": "2"
                }
              }
            }
          ]
        },
        {
          "id": "p2-failed",
          "title": "a record the host does not know is the fact sf-property-view-failed {reason: record-unknown}",
          "covers": "events.failed",
          "steps": [
            {
              "script": "(() => { window.__failed = []; document.getElementById('missing').addEventListener('sf-property-view-failed', (event) => window.__failed.push(event.detail)); return true; })()",
              "wait": 10
            },
            {
              "script": "(() => { window.__calls = []; let revision = 1; const record = (id) => ({record_id: id, collection: 'workbench.solutions', revision: String(revision), label: 'Портал клиента', editable: true, actions: ['record.edit'], address: '/admin/r1', sections: [{key: 'main', label: 'Основное', groups: [{key: 'g', label: 'Главное', columns: 1, fields: [{key: 'title', label: 'Название', propertyType: 'string', width: 'full', value: 'Портал клиента'}]}]}, {key: 'links', label: 'Связи', groups: [{key: 'l', label: 'Ссылки', columns: 1, fields: [{key: 'site', label: 'Сайт', propertyType: 'string', width: 'full', value: 'simai.io'}]}]}]}); const port = {id: 'simai.property-view-port', version: '1.14.0', capabilities: [], raise: async (intent, payload) => { window.__calls.push(intent); if (window.__never) return new Promise(() => {}); if (intent === 'record.load') return payload.record_id === 'r1' ? {answer: 'applied', record: record('r1')} : {answer: 'refused', reason: 'record-unknown', message: 'Запись не найдена'}; if (intent === 'group.save') { revision += 1; return {answer: 'applied', revision: String(revision), record: record('r1')}; } return {answer: 'unavailable', reason: 'capability-not-provided'}; } }; document.querySelectorAll('sf-property-view').forEach((one) => one.setHostPort(port)); return true; })()",
              "wait": 900,
              "check": "window.__failed.length === 1 && window.__failed[0].reason === 'record-unknown' && window.__failed[0].message === 'Запись не найдена'"
            }
          ]
        },
        {
          "id": "p3-panel-hidden",
          "title": "a panel shows while it is not hidden: hidden closes its drawer, removing hidden opens it again (one element)",
          "covers": "settings.open, hidden (simai/ui-pro#4 item 2, §7.2.2)",
          "steps": [
