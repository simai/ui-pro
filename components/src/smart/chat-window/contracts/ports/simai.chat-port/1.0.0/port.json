  "settings": {
    "layers": [
      "personal"
    ],
    "shared_only_fields": [],
    "reset": {
      "semantics": "compare-and-set",
      "summary": "The chat keeps no settings of its own in 1.0.0; the theme and the language are the page's."
    },
    "target": {
      "kinds": [
        "personal"
      ],
      "carries_revision": false
    }
  },
  "answer": {
    "summary": "Every intent is answered with one object: answer says what happened, reason why it was refused or is unavailable (words in the reader's language, never server diagnostics or HTML), data what an applied answer supplies. A conflict carries the current message beside answer; the component keeps the typed text. access-revoked and session-expired are reasons the component knows.",
    "schema": {
      "type": "object",
      "required": [
        "answer"
      ],
      "properties": {
        "answer": {
          "enum": [
            "applied",
            "conflict",
            "refused",
            "unavailable"
          ]
        },
        "reason": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "data": {
          "type": "object"
        },
        "current": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "author"
          ],
          "properties": {
            "id": {
              "type": [
                "integer",
                "string",
                "null"
              ],
              "description": "null only for a send not yet stored (then local is required)."
            },
            "kind": {
              "enum": [
                "person",
                "assistant"
              ],
              "description": "person: written by a person (the reader or another); assistant: an answer of an AI assistant."
            },
            "author": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "avatar_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "own": {
                  "type": "boolean",
                  "description": "The reader wrote it."
                }
              }
            },
            "body": {
              "type": [
                "string",
                "null"
              ],
              "description": "Plain text; shown as text, line breaks kept."
            },
            "html": {
              "type": [
                "string",
                "null"
              ],
              "description": "assistant only: server HTML, sanitized again by the component."
            },
            "created_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "description": "Omitted when the host does not know it; the component never invents a time."
            },
            "status": {
              "enum": [
                "queued",
                "running",
                "completed",
                "partial",
                "refused",
                "withheld",
                "failed",
                "limit"
              ],
              "description": "assistant only."
            },
            "stage": {
              "type": [
                "string",
                "null"
              ]
            },
            "wait": {
              "enum": [
                "delayed",
                "stopped",
                "network",
                "none",
                null
              ],
              "description": "assistant only: the reader's wait for an answer still running — taking long, stopped by the reader, no connection; none: no longer awaited."
            },
            "finished_at": {
              "type": [
                "string",
                "null"
              ],
              "description": "When an answer was finished, if the host knows it."
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "verification": {
              "type": [
                "object",
                "null"
              ]
            },
            "notices": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "proposal": {
              "type": [
                "object",
                "null"
              ],
              "description": "capability proposals: a change applied only on the confirmed command."
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  },
                  "key": {
                    "type": "string",
                    "description": "Local opaque key of a file not yet stored (a failed upload); never sent to download or delete."
                  },
                  "name": {
                    "type": "string"
                  },
                  "size": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "mime": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "download_url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The host's own protected link, as given; the component never builds one."
                  },
                  "state": {
                    "enum": [
                      "uploading",
                      "failed",
                      "ready"
                    ]
                  },
                  "progress": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Why the host refused the file, in the reader's words."
                  }
                }
              }
            },
            "is_edited": {
              "type": "boolean"
            },
            "is_deleted": {
              "type": "boolean",
              "description": "A tombstone: no body, no files."
            },
            "revision": {
              "type": [
                "integer",
                "string"
              ]
            },
            "can_edit": {
              "type": "boolean"
            },
            "can_delete": {
              "type": "boolean"
            },
            "command": {
              "type": [
                "object",
                "null"
              ],
              "description": "A message sent for a button (a proposal's command): {kind: confirm|cancel, code}."
            },
            "local": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "client_key",
                "action",
                "state"
              ],
              "properties": {
                "client_key": {
                  "type": "string"
                },
                "action": {
                  "enum": [
                    "send",
                    "edit",
                    "delete"
                  ]
                },
                "state": {
                  "enum": [
                    "pending",
                    "failed",
                    "sent"
                  ]
                },
                "body": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "An edit's typed text; kept on failure and conflict."
                }
              }
            }
          }
        }
      }
    }
  },
  "conformance": {
    "kit": "kit",
    "sha256": "1cc11e4503bbe8fe240bc79c93ad8ae8486810af9065b650284567f3172cceb9",
    "cases": 14
  },
  "compatibility": {
    "previous_major": null,
    "supported_until": null,
    "recheck": [
      "the component never requests the network; every write is an intent the host answers",
      "a message's rights are its can_edit and can_delete, never its author",
      "the same client_key retried is the same message; a changed body under a pending key is an IDEMPOTENCY conflict",
      "an edit or delete carries the revision it was made from; a stale one is answered conflict with the current message, and the typed text stays",
      "history never moves live cursors; a late file joins its message; a newer revision wins",
      "revoked clears the feed, the draft and anything unsent",
      "a send not yet stored is id null with local; the stored one replaces it by client_key with local.state sent",
      "no created_at, no time shown; no read receipts, typing or presence unless a later version adds them",
      "an assistant answer's html is sanitized again by the component",
      "a capability the host does not announce is not offered; creating a conversation and managing conversations are separate capabilities",
      "no open conversation is conversation null, never an invented id or can_send",
      "a retried edit or delete keeps its original revision",
      "a message's feedback, summary and limit_resets_at, a source's excerpt and a rating's note are optional: a host that leaves them out gets the window it had",
      "message discussions (openThread), participants, roles and ownership are not in 1.0.0"
    ]
  }
}
