  "ai_guidance": {
    "use_when": "Use sf-chat-interlocutor in a chat window's header to name whom the conversation is with and, when the server lists several, to let the person choose another one, which the host turns into a new conversation.",
    "do_not": [
      "Do not change the interlocutor of an existing conversation; start a new one and write value back",
      "Do not use it to pick a conversation: that is sf-chat-threads",
      "Do not pass markup in titles; they are text"
    ],
    "required_reads": [
      "inputs",
      "contracts",
      "events",
      "accessibility"
    ],
    "minimal_example": "<sf-chat-interlocutor value=\"personal\"></sf-chat-interlocutor>",
    "owner_commands": [
      "node scripts/test.mjs",
      "node scripts/run-manifest-probes.mjs <free output> <package output> chat-interlocutor"
    ]
  }
}
