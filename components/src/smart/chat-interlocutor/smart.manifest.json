{
  "schema_version": 2,
  "id": "smart.chat-interlocutor",
  "version": "1.0.6",
  "title": "Chat interlocutor",
  "summary": "Who the conversation is with: the server's interlocutors in the Framework's context menu, the current one checked, and a choice of another reported for the host to start a new conversation with. One interlocutor is a name, not a choice.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "chat",
    "interlocutor",
    "picker",
    "menu"
  ],
  "capabilities": [
    "interaction",
    "keyboard",
    "search",
    "responsive"
  ],
  "custom_element": "sf-chat-interlocutor",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "smart.icon",
      "smart.menu-context"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "properties": {
      "template": {
        "type": "string",
        "default": "default",
        "description": "Template variant name for SfBaseElement external templates.",
        "const": "default"
      },
      "root-class": {
        "type": "string",
        "default": "",
        "description": "Classes added to the root element the component draws."
      },
      "root-style": {
        "type": "string",
        "default": "",
        "description": "Inline style declarations set on the root element the component draws, custom properties included."
      },
      "value": {
        "type": "string",
        "default": "",
        "description": "the current interlocutor; a choice asks for another with select {id} and the host writes it back when its new conversation is there"
      },
      "options": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The interlocutor's id."
            },
            "title": {
              "type": "string",
              "description": "Its name, drawn as text."
            },
            "kind": {
              "type": "string",
              "description": "knowledge: a knowledge base's assistant, under its own heading."
            }
          },
          "required": [
            "id",
            "title"
          ]
        },
        "description": "The interlocutors (bootstrap.interlocutors), a property or the JSON island; from eight the menu gets a search."
      }
    },
    "additionalProperties": false
  },
  "item_contract": {},
  "contracts": {
    "option": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The interlocutor's id."
        },
        "title": {
          "type": "string",
          "description": "Its name, drawn as text."
        },
        "kind": {
          "type": "string",
          "description": "knowledge: a knowledge base's assistant, under its own heading."
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "choice": {
      "const": "A choice of another interlocutor dispatches sf-chat-interlocutor-select {id} (cancelable). The element never changes value: the host starts the new conversation and writes value back. Fewer than two interlocutors are a name: the button is disabled and open answers refused single."
    },
    "css_variables": {
      "type": "object",
      "properties": {
        "--sf-chat-interlocutor-color": {
          "type": "string"
        },
        "--sf-chat-interlocutor-icon-color": {
          "type": "string"
        },
        "--sf-chat-interlocutor-hover-background-color": {
          "type": "string"
        },
        "--sf-chat-interlocutor-radius": {
          "type": "string"
        },
        "--sf-chat-interlocutor-height": {
          "type": "string"
        }
      }
    }
  },
  "methods": {
    "setOptions": {
      "summary": "The interlocutors, as the options property (the action set-options); kind knowledge goes under its own heading, from eight the menu gets a search.",
      "arguments": [
        {
          "name": "options",
          "schema": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The interlocutor's id."
                },
                "title": {
                  "type": "string",
                  "description": "Its name, drawn as text."
                },
                "kind": {
                  "type": "string",
                  "description": "knowledge: a knowledge base's assistant, under its own heading."
                }
              },
              "required": [
                "id",
                "title"
              ]
            }
          }
        }
      ],
      "returns": {
        "type": "object",
        "description": "{outcome: applied}"
      }
    },
    "open": {
      "summary": "Open the menu, as a press does; refused single with fewer than two interlocutors.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason}"
      }
    }
  },
  "events": {
    "sf-chat-interlocutor-select": {
      "summary": "Another interlocutor was chosen (vocabulary select). The 0.3 name sf-chat-interlocutor follows it until 2026-12-01.",
      "payload": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {}
        },
        "additionalProperties": true
      },
      "canonical": true
    },
    "sf-chat-interlocutor": {
      "summary": "Dated alias of sf-chat-interlocutor-select until 2026-12-01 (same-detail).",
      "payload": {
        "type": "object"
      },
      "alias_of": "sf-chat-interlocutor-select"
    }
  },
  "state": {
    "machines": {
      "menu": [
        "closed",
        "open"
      ],
      "options": [
        "single",
        "several"
      ]
    },
    "visual_states": [
      "default",
      "disabled",
      "open",
      "closed"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "host",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-pro",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "fetching or polling the chat API",
      "starting a conversation",
      "access decisions"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "interlocutor titles (drawn as text)"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "button",
    "accessible_name": "internal",
    "keyboard": [
      "Tab",
      "Enter",
      "Space"
    ],
    "focus": "A native button with aria-haspopup=menu and aria-expanded=false from the start, named «Помощник: <title>» and described (sr-only) by what a change does before the menu opens. The menu is the Framework's sf-menu-context with radio rows, the current one checked, and its own keys. Disabled, without aria-haspopup, aria-expanded or a description, with a single interlocutor."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "en",
      "ru"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ]
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": [
      "studio.scenario.json"
    ]
  },
  "readiness": {
    "level": "host-required",
    "required_checks": [
      "manifest",
      "loader-rule",
      "chat-interlocutor-probe"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "0edd49be08f802b60ed92f176b68911a42a12f3f",
      "ui_smart_revision": "0edd49be08f802b60ed92f176b68911a42a12f3f"
    },
    "aliases": [],
    "deprecations": [],
    "replacement": null,
    "migrations": [
      {
        "from": "0.3.1",
        "to": "1.0.0",
        "changes": [
          "moved from simai/ui-chat to ui-pro (D31): standard simai.smart-component 1.3.9, the element is made from component.json; words in lang/; dated aliases in aliases.json",
          "sf-chat-interlocutor -> sf-chat-interlocutor-select until 2026-12-01 (event)",
          "setOptions(list) is the action set-options and the setting options"
        ]
      },
      {
        "from": "1.0.0",
        "to": "1.0.1",
        "changes": [
          "The first-paint snapshot's sheets.json lists the utility sheets its markup uses (retaken on ui-source 5ba9399); no behaviour changed. Nothing to change for a host."
        ]
      },
      {
        "from": "1.0.3",
        "to": "1.0.4",
        "changes": [
          "Draws and finds the renamed Framework elements by their new tags (the choice opens in sf-menu-context); the rule relations name cl-<new>. Needs the SIMAI Framework pair with the tag renames (core.runtime 1.21.0). No visible change. Nothing to change for a host on that pair; a host that writes the former tags keeps working until 2027-01-01."
        ]
      },
      {
        "from": "1.0.4",
        "to": "1.0.5",
        "changes": [
          "Its guidance names the conversation list by its new tag, sf-chat-threads (was sf-thread-list). No change in behaviour."
        ]
      }
    ]
  },
