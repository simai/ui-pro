{
  "schema_version": 2,
  "id": "smart.change-confirm",
  "version": "1.1.1",
  "title": "Change confirmation",
  "summary": "A prepared change put to a person: each value as it was and as it will be, two answers of equal weight, until when it can be answered, and then only the outcome. Applies nothing; a press is an event.",
  "kind": "smart",
  "reuse_mode": "whole",
  "lifecycle": "experimental",
  "tags": [
    "confirmation",
    "change",
    "diff",
    "chat"
  ],
  "capabilities": [
    "confirmation",
    "expiry",
    "live-announcement"
  ],
  "custom_element": "sf-change-confirm",
  "templates": [
    "default"
  ],
  "exported_parts": [],
  "composition": {
    "uses": [
      "smart.button",
      "smart.icon"
    ],
    "public_parts": []
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "template": {
        "type": "string",
        "const": "default",
        "default": "default"
      },
      "heading": {
        "type": "string",
        "default": "",
        "description": "What the change is; without one the card is named «What will change»."
      },
      "heading-level": {
        "enum": [
          "2",
          "3",
          "4",
          "5",
          "6"
        ],
        "default": "3",
        "description": "The heading's level where the card is placed."
      },
      "state": {
        "enum": [
          "open",
          "pending",
          "accepted",
          "declined",
          "expired"
        ],
        "default": "open",
        "description": "open: the answers are offered. pending: an answer is on its way (set by a press). accepted, declined, expired: only the outcome is shown."
      },
      "expires-at": {
        "type": "string",
        "default": "",
        "description": "ISO 8601. Past it an open card reads as expired and says so once with sf-change-confirm-expire."
      },
      "change-id": {
        "type": "string",
        "default": "",
        "description": "The host's name for the change, carried back in every event."
      },
      "disabled": {
        "type": "boolean",
        "default": false,
        "description": "The answers are shown and cannot be pressed (a send is in flight elsewhere)."
      },
      "accept-text": {
        "type": "string",
        "default": "",
        "description": "The accepting answer; empty is Confirm in the page's language."
      },
      "decline-text": {
        "type": "string",
        "default": "",
        "description": "The declining answer; empty is Decline in the page's language."
      },
      "changes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "description": "What changes (a field's name)."
            },
            "before": {
              "type": [
                "string",
                "number",
                "null"
              ],
              "description": "The value as it is; empty or null reads as empty."
            },
            "after": {
              "type": [
                "string",
                "number",
                "null"
              ],
              "description": "The value as it will be."
            }
          },
          "required": [
            "label"
          ]
        },
        "default": [],
        "description": "The values, as JSON in markup; a property set from script wins."
      }
    }
  },
  "contracts": {
    "change": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "What changes (a field's name)."
        },
        "before": {
          "type": [
            "string",
            "number",
            "null"
          ],
          "description": "The value as it is; empty or null reads as empty."
        },
        "after": {
          "type": [
            "string",
            "number",
            "null"
          ],
          "description": "The value as it will be."
        }
      },
      "required": [
        "label"
      ]
    },
    "answers": {
      "const": "A press moves the card to pending and dispatches sf-change-confirm-answer {id, accepted} (cancelable). A cancelled event returns it to open. The host sets the outcome: accepted, declined, or open again when the answer could not be delivered. The card never applies anything."
    },
    "slots": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "A line under the heading (a code, who proposed it)."
        }
      }
    },
    "css_variables": {
      "type": "object",
      "properties": {
        "--sf-change-confirm-radius": {
          "type": "string"
        },
        "--sf-change-confirm-inset": {
          "type": "string"
        },
        "--sf-change-confirm-gap": {
          "type": "string"
        },
        "--sf-change-confirm-before-background-color": {
          "type": "string"
        },
        "--sf-change-confirm-after-background-color": {
          "type": "string"
        },
        "--sf-change-confirm-after-color": {
          "type": "string"
        }
      }
    }
  },
  "methods": {
    "answer": {
      "summary": "Answer as the person would: accepted true confirms, false declines. Refused closed, disabled or prevented. answer('accept') and answer('decline') are read until 2026-12-01.",
      "arguments": [
        {
          "name": "accepted",
          "required": true,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason}"
      }
    },
    "confirm": {
      "summary": "The acceptance; data-sf-action=\"<id>.confirm\".",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason}"
      }
    },
    "cancel": {
      "summary": "The declining answer; data-sf-action=\"<id>.cancel\".",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason}"
      }
    },
    "open": {
      "summary": "Puts the question again; asked by an assembly it answers {accepted, reason, value} when the person answers or the time runs out.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "{outcome: applied} or {outcome: refused, reason}"
      }
    }
  },
  "events": {
    "sf-change-confirm-answer": {
      "summary": "The person answered (vocabulary answer). Cancel it to keep the question open. The 1.0 names sf-change-confirm-accept and -decline follow it until 2026-12-01.",
      "payload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "change-id"
          },
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "accepted"
        ]
      }
    },
    "sf-change-confirm-expired": {
      "summary": "An open card passed expires-at; said once per time. The 1.0 name sf-change-confirm-expire follows it until 2026-12-01.",
      "payload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "change-id"
          }
        },
        "required": [
          "id"
        ]
      }
    }
  },
  "state": {
    "machines": {
      "answer": [
        "open",
        "pending",
        "accepted",
        "declined",
        "expired"
      ]
    },
    "visual_states": [
      "default",
      "loading",
      "success",
      "disabled"
    ]
  },
  "persistence": {
    "mode": "none",
    "source_of_truth": "host",
    "network_owner": "host",
    "revision_field": null
  },
  "ownership": {
    "source": "simai/ui-pro",
    "data": "host",
    "effects": "host",
    "forbidden_client_responsibilities": [
      "applying the change",
      "composing a command or a code for the server",
      "access decisions"
    ]
  },
  "security": {
    "permissions_owner": "host",
    "untrusted_inputs": [
      "heading, labels and values (drawn as text)"
    ],
    "network_policy": "deny"
  },
  "accessibility": {
    "role": "region",
    "accessible_name": "internal",
    "keyboard": [
      "Tab",
      "Enter",
      "Space"
    ],
    "focus": "A section named by its heading (role=heading at heading-level). The values are a description list. The status line is a polite live region, present before it speaks; when a press takes the answers away, focus moves to it instead of falling to the page, and back to the first answer when the host cancels."
  },
  "presentation": {
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "en",
      "ru"
    ],
    "responsive": [
      "desktop",
      "mobile"
    ],
    "skeleton": {
      "shape": "none",
      "while_loading": "none"
    }
  },
  "adapter": {
    "kind": "generic",
    "protocol": "simai.smart-studio-adapter.v1",
    "module": null
  },
  "artifacts": {
    "fixtures": [
      "studio.fixture.json"
    ],
    "scenarios": []
  },
  "readiness": {
    "level": "host-required",
    "required_checks": [
      "manifest",
      "loader-rule",
      "change-confirm-contract",
      "change-confirm-browser"
    ]
  },
  "compatibility": {
    "contract_schema": {
      "id": "https://simai.io/contracts/smart-component-manifest.v2.schema.json",
      "version": 2
    },
    "runtime_pair": {
      "ui_revision": "89834691fb9dce692be5353f3214df7aee3a7e27",
      "ui_smart_revision": "89834691fb9dce692be5353f3214df7aee3a7e27"
    },
    "aliases": [],
    "deprecations": [],
    "replacement": null,
    "migrations": [
      {
        "from": "1.0.0",
        "to": "1.1.0",
        "changes": [
          "standard simai.smart-component 1.3.8: the element is made from component.json; dated aliases in aliases.json",
          "sf-change-confirm-accept -> sf-change-confirm-answer until 2026-12-01 (event)",
          "sf-change-confirm-decline -> sf-change-confirm-answer until 2026-12-01 (event)",
          "sf-change-confirm-expire -> sf-change-confirm-expired until 2026-12-01 (event)"
        ]
      }
    ]
  },
  "provenance": {
