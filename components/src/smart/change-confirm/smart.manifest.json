  "ai_guidance": {
    "use_when": "Use sf-change-confirm wherever a prepared change waits for a person's yes or no -- an assistant's proposal, a colleague's edit, an import. Promoted from simai/ui-chat renderProposal (owner decision 2026-10-25).",
    "do_not": [
      "Do not apply the change in the element; answer the event and set state",
      "Do not leave the card pending: set accepted, declined, or open again",
      "Do not pass markup in values; they are text"
    ],
    "required_reads": [
      "inputs",
      "contracts",
      "events",
      "accessibility"
    ],
    "minimal_example": "<sf-change-confirm heading=\"Переименовать раздел\" change-id=\"c1\" changes='[{\"label\":\"Название\",\"before\":\"Новости\",\"after\":\"События\"}]'></sf-change-confirm>",
    "owner_commands": [
      "node scripts/test.mjs",
      "node scripts/run-browser-probes.mjs <free output> <package output>"
    ]
  }
}
