  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "aria-label"
    ],
    "properties": {
      "template": {
        "type": "string",
        "const": "default",
        "default": "default"
      },
      "brand": {
        "type": "string",
        "default": ""
      },
      "logo": {
        "type": "string",
        "default": ""
      },
      "logo-href": {
        "type": "string",
        "default": "#"
      },
      "aria-label": {
        "type": "string",
        "minLength": 1,
        "default": "Admin menu"
      },
      "searchable": {
        "type": "boolean",
        "default": false
      },
      "collapsible": {
        "type": "boolean",
        "default": false
      },
      "settings": {
        "type": "boolean",
        "default": true
      },
      "settings-title": {
        "type": "string",
        "default": "Menu settings"
      },
      "compact": {
        "type": "boolean",
        "default": false
      },
      "persistence-mode": {
        "type": "string",
        "enum": [
          "local",
          "external"
        ],
        "default": "local"
      },
      "settings-mode": {
        "type": "string",
        "enum": [
          "user",
          "system"
        ],
