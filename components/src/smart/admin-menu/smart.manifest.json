  "methods": {
    "applyExternalSettingsState": {
      "summary": "Apply backend-resolved state and tree.",
      "arguments": [
        {
          "name": "state",
          "schema": {
            "type": "object"
          }
        },
        {
          "name": "target",
          "schema": {
            "enum": [
              "user",
              "system"
            ]
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    },
    "applySettingsResult": {
      "summary": "Commit a successful external save response.",
      "arguments": [
        {
          "name": "result",
          "schema": {
            "type": "object"
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    },
    "applySettingsError": {
      "summary": "Keep the draft and expose error or conflict state.",
      "arguments": [
        {
          "name": "error",
          "schema": {
            "type": "object"
          }
        }
      ],
      "returns": {
        "type": "null"
      }
    },
    "setCompact": {
      "summary": "Set compact navigation mode.",
      "arguments": [
        {
          "name": "compact",
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "returns": {
        "type": "boolean"
      }
    },
    "toggleMenuSettings": {
      "summary": "Enter or leave the settings editor.",
      "arguments": [],
      "returns": {
        "type": "null"
      }
    },
    "refresh": {
      "summary": "Read the navigation menu again from its host, after something outside the menu changed what it shows (a star in the page header). No effect on the items menu.",
      "arguments": [],
      "returns": {
        "type": "object",
        "description": "A promise that settles when the host has answered."
      }
    },
    "setHostPort": {
      "summary": "Bind the host of simai.admin-navigation-port; the menu then draws the navigation shell instead of the items menu.",
      "arguments": [
        {
          "name": "host",
          "type": "object",
          "required": true
        }
      ],
      "returns": {
        "type": "object",
        "description": "The element, for chaining."
      }
    },
    "setSearchResults": {
      "summary": "The host answers one search request with its own groups of results. An answer to a query the person has moved on from is dropped.",
      "arguments": [
        {
          "name": "requestId",
          "type": "string",
          "required": true
        },
        {
          "name": "groups",
          "type": "array",
          "required": false
        }
      ],
      "returns": {
        "type": "boolean",
        "description": "Whether the answer was for the current query and was shown."
      }
    },
    "setRecentResults": {
      "summary": "What the host offers an empty search field: a recent list, standing until it sets another.",
      "arguments": [
        {
          "name": "groups",
          "type": "array",
          "required": false
        }
      ],
      "returns": {
        "type": "boolean",
        "description": "Always true."
      }
    }
  },
  "events": {
    "sf-admin-menu-compact-change": {
      "summary": "Notify the host shell about width mode.",
      "payload": {
        "type": "object",
        "required": [
          "compact",
          "source"
