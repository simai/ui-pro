        "type": "object",
        "properties": {
          "target": {
            "enum": [
              "user",
              "system"
            ]
          }
        }
      }
    },
    "sf-admin-menu-settings-mode-change": {
      "summary": "Request state for another settings level.",
      "payload": {
        "type": "object",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "enum": [
              "user",
              "system"
            ]
          }
        }
      }
    },
    "sf-admin-menu-settings-refresh": {
      "summary": "Request fresh backend state after a conflict.",
      "payload": {
        "type": "object",
        "required": [
          "target",
          "base_revision",
          "profile"
        ],
        "properties": {
          "target": {
            "enum": [
              "user",
              "system"
            ]
          },
          "base_revision": {
            "type": "integer",
            "minimum": 0
          },
          "profile": {
            "$ref": "#/contracts/settings_profile"
          }
        }
      }
    },
    "sf-admin-menu-settings-reset": {
      "summary": "Request reset of the selected preference level.",
      "payload": {
        "type": "object",
        "required": [
          "target",
          "base_revision"
        ],
        "properties": {
          "target": {
            "enum": [
              "user",
              "system"
            ]
          },
          "base_revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "sf-admin-menu-settings-save": {
      "summary": "Request persistence of the current delta.",
      "payload": {
        "type": "object",
        "required": [
          "target",
          "base_revision",
          "profile"
        ],
        "properties": {
          "target": {
            "enum": [
              "user",
              "system"
            ]
          },
          "base_revision": {
            "type": "integer",
            "minimum": 0
          },
          "profile": {
            "$ref": "#/contracts/settings_profile"
          }
        }
      }
    },
    "sf-host-port-request": {
      "summary": "Ask the page for a host port when connecting. A page that answers with simai.admin-navigation-port gets the navigation shell; a page that answers nothing gets the items menu, unchanged.",
      "payload": {
        "type": "object",
        "required": [
          "component",
          "context"
        ],
        "properties": {
          "component": {
            "type": "object"
          },
          "context": {
            "type": "object",
            "required": [
              "owner",
              "record",
              "group"
            ],
            "properties": {
              "owner": {
                "type": "string",
                "const": "admin-menu"
              },
              "record": {
                "type": "null"
              },
              "group": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    "sf-admin-menu-navigate": {
      "summary": "The host answered item.open applied: the page belongs to this row now. For a host that navigates in its own router rather than through the address it answered with.",
      "payload": {
        "type": "object",
        "required": [
          "key",
          "href"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "href": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "sf-admin-menu-intent": {
      "summary": "What a person asked of the host, announced for every intent of simai.admin-navigation-port as the menu raises it. The host answers through the port, not through this event.",
      "payload": {
        "type": "object",
        "required": [
          "intent",
          "payload"
        ],
        "additionalProperties": false,
        "properties": {
          "intent": {
            "type": "string",
            "description": "The port intent, e.g. navigation.load or favourite.add."
          },
          "payload": {
            "type": "object",
            "description": "The intent's payload as the port declares it."
          }
        }
      }
    }
  },
